bool 'glib'	 	CONFIG_USER_GLIB
if [ "$CONFIG_USER_GLIB" = "y" ]; then
	define_bool CONFIG_LIB_ZLIB y
	define_bool CONFIG_LIB_LIBFFI y
	choice 'GLIB Version'		"2.56.1 CONFIG_USER_GLIB_VERSION_2_56_1 \
									2.41.1 CONFIG_USER_GLIB_VERSION_2_41_1" 2.56.1
	if [ "$CONFIG_USER_GLIB_VERSION_2_56_1" = "y" ]; then
		define_string CONFIG_USER_GLIB_VERSION "2.56.1"
	elif [ "$CONFIG_USER_GLIB_VERSION_2_41_1" = "y" ]; then
		define_string CONFIG_USER_GLIB_VERSION "2.41.1"
	fi
fi
