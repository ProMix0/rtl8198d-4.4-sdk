	bool "Use ASIC MDC/MDIO to control RTL83XX switch"
	help
	  For Realtek RTL83XX controlled by ASIC MDC/MDIO.

config RTL83XX_MDIO_GPIO
	bool "Use GPIO lib-based MDC/MDIO to control RTL83XX switch"
        select MDIO_BITBANG
        select MDIO_GPIO
	help
	  For Realtek RTL83XX controlled by MDC/MDIO which is simulated by GPIO.

config RTL83XX_I2C
	bool "Use I2C protocol to control RTL83XX switch"
	help
	  For Realtek RTL83XX controlled by I2C which is simulated by GPIO.

endchoice

