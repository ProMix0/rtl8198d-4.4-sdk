/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "ca7774-soc_asic.dtsi"
#include "ca7774-soc-clks.dtsi"
#include "ca77xx-nand.dtsi"
#include "ca77xx-crypto.dtsi"
#include "ca77xx-led.dtsi"

/* board specific and SoC overrides below */
/ {
	model = "Cortina Access G3 Engineering Board";
	compatible = "cortina,g3fpga", "cortina,ca7774";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
                ethernet0 = &eth0;
                ethernet1 = &eth1;
	};

	memory { /* 2GB */
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x80000000>;
	};

	ca_peri{
		compatible = "cortina,ca-peri";
		reg = <0x0 0xf4329018 0x0 0x400>,
		      <0x0 0xf4320000 0x0 0x60>;
		interrupt-parent = <&per_ictl>;
		interrupts = <2>; 
		interrupt-names = "TMR1";
	};

#if 0		/* Enable below node if UART2/3 are necessary */
	uart2: uart@f43291a8 {
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291a8 0x0 0x30>;	/* UART base address */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART2 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&uart2_default>;
		pinctrl-names = "default";
	};
	uart3: uart@f43291d8 {
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291d8 0x0 0x30>;	/* UART base address */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART3 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&uart3_default>;
		pinctrl-names = "default";
	};
#endif

#if 0
	/* APB clock varies based on G3 config */
	/* TODO: develop clock driver to switch between freq. for now use fixed freq. */
	apb_pclk: g3_apb_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};
#endif

	sd_clk: g3_sd_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

#if 0
	/* SD clock provides 50/100/200 Mhz */
	/* TODO: develop clock driver to switch between this freq. for now use fixed freq. */
	sd_clk: g3_sd_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};
	/* PCIe clock provides 250 Mhz */
	pcie_clk: g3_pcie_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};
	/* PCIe BUS clock provides 250 Mhz */
	pcie_bclk: g3_pcie_bclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};

	/* USB 2 clock provides 60 Mhz */
	usb2_clk: g3_usb2_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <60000000>;
	};

	smb { /* simple bus */

		uart0: uart@0xf4570114 {
			device_type = "serial";
			compatible = "cortina,serial";
			reg = <0x0 0xf4570114 0x0 0x30>; /* TODO - when memory map available */
			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";
			interrupts = <0 32 0x1>; /* TODO - when interrupt map available */
		};

		uart1: uart@f4570144 {
			device_type = "serial";
			compatible = "cortina,serial";
			reg = <0x0 0xf4570144 0x0 0x30>; /* TODO - when memory map available */
			clocks = <&apb_pclk>;
			interrupts = <0 32 0x1>; /* edge triggered */
		};

	};
#endif

	gpio-reset {
		compatible = "linux,gpio-reset";

		pcie0_device_rst: pcie0_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <150>;
		};

		pcie1_device_rst: pcie1_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <10>;
		};

		pcie2_device_rst: pcie2_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 255 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <10>;
		};
	};
};

/* "okay" - turn on, "disabled" - turn off */
&glb_phy {
	/* forced-on; */
};

&pcie0 {
	/* status = "disabled"; */

	resets = <&block_rst PCI0_RESET>, <&dphy_rst PHY_S0_PCIE_RESET>,
		 <&pcie0_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <150>; /* device with embedded OS system */

	dma-coherent;
	linux,pci-domain = <0>;
	bus-range = <0x0 0x0>; /* save scan time */

	serdes-cfg0 = <0xf4333004 0xa84a>,
		      <0xf4333008 0x6042>,
		      <0xf4333010 0x4000>,	/* BIT13: SSC */
		      <0xf4333018 0x0007>,	/* Icp */
		      <0xf4333024 0x520c>,
		      <0xf4333028 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433302c 0x7905>,
		      <0xf4333034 0xf722>,
		      <0xf433303c 0x6000>,
		      <0xf4333044 0x4400>,
		      <0xf4333068 0x0000>,
		      <0xf4333070 0x0420>,
		      <0xf4333080 0x9477>,
		      <0xf4333090 0x0806>,
		      <0xf43330ac 0xa803>,
		      <0xf43330b8 0xfffe>,
		      <0xf4333098 0xc409>,

		      <0xf4333104 0xa84a>,
		      <0xf4333108 0x6042>,
		      <0xf4333110 0x4000>,	/* BIT13: SSC */
		      <0xf4333118 0x0007>,	/* Icp */
		      <0xf4333124 0x520c>,
		      <0xf4333128 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433312c 0x7905>,
		      <0xf4333134 0xf722>,
		      <0xf433313c 0x6000>,
		      <0xf4333144 0x4400>,
		      <0xf4333168 0x0000>,
		      <0xf4333170 0x0420>,
		      <0xf4333180 0x9477>,
		      <0xf4333190 0x0806>,
		      <0xf43331ac 0xa803>,
		      <0xf43331b8 0xfffe>,
		      <0xf4333198 0xc409>;

	serdes-cfg1 = <0xf4334004 0xa84a>,
		      <0xf4334008 0x6042>,
		      <0xf4334010 0x4000>,	/* BIT13: SSC */
		      <0xf4334018 0x0007>,	/* Icp */
		      <0xf4334024 0x520c>,
		      <0xf4334028 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433402c 0x7905>,
		      <0xf4334034 0xf722>,
		      <0xf433403c 0x6000>,
		      <0xf4334044 0x4400>,
		      <0xf4334068 0x0000>,
		      <0xf4334070 0x0420>,
		      <0xf4334080 0x9477>,
		      <0xf4334090 0x0806>,
		      <0xf43340ac 0xa803>,
		      <0xf43340b8 0xfffe>,
		      <0xf4334098 0xc409>,

		      <0xf4334104 0xa84a>,
		      <0xf4334108 0x6042>,
		      <0xf4334110 0x4000>,	/* BIT13: SSC */
		      <0xf4334118 0x0007>,	/* Icp */
		      <0xf4334124 0x520c>,
		      <0xf4334128 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433412c 0x7905>,
		      <0xf4334134 0xf722>,
		      <0xf433413c 0x6000>,
		      <0xf4334144 0x4400>,
		      <0xf4334168 0x0000>,
		      <0xf4334170 0x0420>,
		      <0xf4334180 0x9477>,
		      <0xf4334190 0x0806>,
		      <0xf43341ac 0xa803>,
                      <0xf43341b8 0xfffe>,
		      <0xf4334198 0xc409>;
};

&pcie1 {
	/* status = "disabled"; */

	resets = <&block_rst PCI1_RESET>, <&dphy_rst PHY_S1_PCIE_RESET>,
		 <&pcie1_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <50>;

	dma-coherent;
	linux,pci-domain = <1>;
	bus-range = <0x0 0x0>; /* save scan time */

	serdes-cfg0 = <0xf4335004 0xa84a>,
		      <0xf4335008 0x6042>,
		      <0xf4335010 0x5000>,	/* BIT13: SSC */
		      <0xf4335018 0x0007>,	/* Icp */
		      <0xf4335024 0x520c>,
		      <0xf4335028 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433502c 0x7905>,
		      <0xf4335034 0xf70a>,
		      <0xf4335080 0x9477>,
		      <0xf4335090 0x080c>,
		      <0xf43350ac 0xa803>,
		      <0xf43350bc 0x61bd>,
                      <0xf43350b8 0xfffe>,

		      <0xf4335104 0xa84a>,
		      <0xf4335108 0x6042>,
		      <0xf4335110 0x5000>,	/* BIT13: SSC */
		      <0xf4335118 0x0006>,
		      <0xf4335124 0x520c>,
		      <0xf4335128 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433512c 0x7905>,
		      <0xf4335134 0xf70a>,
		      <0xf4335180 0x9477>,
		      <0xf4335190 0x080c>,
		      <0xf43351ac 0xa803>,
		      <0xf43351bc 0x61bd>,
                      <0xf43351b8 0xfffe>;
};

&pcie2 {
	status = "disabled";

	resets = <&block_rst PCI2_RESET>, <&dphy_rst PHY_S2_PCIE_RESET>,
		 <&pcie2_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <50>;

	/* forced-gen1; */
	dma-coherent;
	linux,pci-domain = <2>;
	bus-range = <0x0 0x0>; /* save scan time */

	serdes-cfg0 = <0xf4336004 0xa84a>,
		      <0xf4336008 0x6042>,
		      <0xf4336010 0x5000>,	/* BIT13: SSC */
		      <0xf4336018 0x0007>,	/* Icp */
		      <0xf4336024 0x520c>,
		      <0xf4336028 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433602c 0x7905>,
		      <0xf4336034 0xf70a>,
		      <0xf4336080 0x9477>,
		      <0xf4336090 0x080c>,
		      <0xf43360ac 0xa803>,
		      <0xf43360bc 0x61bd>,

		      <0xf4336104 0xa84a>,
		      <0xf4336108 0x6042>,
		      <0xf4336110 0x5000>,	/* BIT13: SSC */
		      <0xf4336118 0x0006>,
		      <0xf4336124 0x520c>,
		      <0xf4336128 0xd213>,	/* #LEQ adapt, CMU Rs, Cp */
		      <0xf433612c 0x7905>,
		      <0xf4336134 0xf70a>,
		      <0xf4336180 0x9477>,
		      <0xf4336190 0x080c>,
		      <0xf43361ac 0xa803>,
		      <0xf43361bc 0x61bd>;
};

&usb_hsphy {
	status = "okay";
};

&usb_ssphy {
	status = "okay";
};

&sata {
	status = "okay";
	/* dma-coherent; */
	phys = <&s3_sata_phy>;
	phy-names = "sata-phy";
};


&i2c {
	clock-frequency = <100000>;
	timeout = <1000>;
	retries = <3>;

	i2c-switch@70 {
		compatible = "nxp,pca9544";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x70>;
		/* status = "disabled"; */

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;

			lm75a: hwmon@48 {
				compatible = "nxp,lm75a";
				reg = <0x48>;
				/* status = "disabled"; */
			};
		};
	};
};

&led_ctrl {
	hw-blink-rate1 = <256>;
	hw-blink-rate2 = <512>;
};

&led0 {
	active-low;
#if 0
	label = "Port4:Rx";
	linux,default-trigger = "ca_phy4_rx";
	port = <4>;
	default-state = "disabled";
#else
	label = "KDriver:R4";
	linux,default-trigger = "kdriver_r4";
	on,sw;
	default-state = "enabled";
#endif
};

