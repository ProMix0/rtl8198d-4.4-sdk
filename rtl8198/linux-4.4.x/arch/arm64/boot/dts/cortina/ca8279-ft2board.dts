/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "ca7774-soc_asic.dtsi"
#include "ca7774-soc-clks.dtsi"
#include "ca77xx-nand.dtsi"
#include "ca77xx-crypto.dtsi"
#include "ca77xx-led.dtsi"
#include "ca8279-saturn_soc.dtsi"

/* board specific and SoC overrides below */
/ {
	model = "Cortina Access G3HGU Engineering Board";
	compatible = "cortina,g3fpga", "cortina,ca7774";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
                ethernet0 = &eth0;
                ethernet1 = &eth1;
	};

	memory { /* 2GB */
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x80000000>;
	};

	ca_peri{
		compatible = "cortina,ca-peri";
		reg = <0x0 0xf4329018 0x0 0x400>,
		      <0x0 0xf4320000 0x0 0x60>;
		interrupt-parent = <&per_ictl>;
		interrupts = <2>;
		interrupt-names = "TMR1";
	};

#if 0		/* Enable below node if UART2/3 are necessary */
	uart2: uart@f43291a8 {
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291a8 0x0 0x30>;	/* UART base address */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART2 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&uart2_default>;
		pinctrl-names = "default";
	};
	uart3: uart@f43291d8 {
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291d8 0x0 0x30>;	/* UART base address */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART3 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&uart3_default>;
		pinctrl-names = "default";
	};
#endif

#if 0
	/* APB clock varies based on G3 config */
	/* TODO: develop clock driver to switch between freq. for now use fixed freq. */
	apb_pclk: g3_apb_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};
#endif

	sd_clk: g3_sd_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	slic_clk: ext_slic_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
#if 0
		/* extclk ONLY and divided internally to generate sclk
		 * ISI:24576000, ZSI:49152000
		 */
		clock-frequency = <24576000>;
		clock-output-names = "ext-slic-clk";
#endif
		/* extclk & extsclk BOTH
		 * ISI: extclk - 24576000/extsclk - 2048000
		 * ZSI: extclk - 49152000/extsclk - 4096000
		 */
		clock-frequency = <2048000>;
		clock-output-names = "ext-slic-sclk";
	};

#if 0
	/* SD clock provides 50/100/200 Mhz */
	/* TODO: develop clock driver to switch between this freq. for now use fixed freq. */
	sd_clk: g3_sd_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};
	/* PCIe clock provides 250 Mhz */
	pcie_clk: g3_pcie_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};
	/* PCIe BUS clock provides 250 Mhz */
	pcie_bclk: g3_pcie_bclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};

	/* USB 2 clock provides 60 Mhz */
	usb2_clk: g3_usb2_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <60000000>;
	};

	smb { /* simple bus */

		uart0: uart@0xf4570114 {
			device_type = "serial";
			compatible = "cortina,serial";
			reg = <0x0 0xf4570114 0x0 0x30>; /* TODO - when memory map available */
			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";
			interrupts = <0 32 0x1>; /* TODO - when interrupt map available */
		};

		uart1: uart@f4570144 {
			device_type = "serial";
			compatible = "cortina,serial";
			reg = <0x0 0xf4570144 0x0 0x30>; /* TODO - when memory map available */
			clocks = <&apb_pclk>;
			interrupts = <0 32 0x1>; /* edge triggered */
		};

	};
#endif

    /* Driver for thermal sensor, this sensor located at Saturn diode */
    thermal_sensor1: thermal@f310017c {
		compatible = "cortina,thermal-sensor";
		reg = <0 0xf310017c 0 0x10>;
		#thermal-sensor-cells = <0>;
	};

	thermal_cpu_hotplug: cpu_hotplug {
       compatible = "thermal-cpu-hotplug";
       cooling-min-level = <0>;
       cooling-max-level = <3>;
       #cooling-cells = <2>;
    };

	thermal-zones {
        cpu_thermal: cpu-thermal {
                polling-delay-passive = <500>; /* milliseconds */
                polling-delay = <3000>; /* milliseconds */

                thermal-sensors = <&thermal_sensor1>;

                trips {
                        cpu_alert0: cpu-alert0 {
                                temperature = <90000>; /* millicelsius */
                                hysteresis =  <5000>; /* millicelsius */
                                type = "active";
                        };
                        cpu_hot0: cpu-hot0 {
                                temperature = <105000>; /* millicelsius */
                                hysteresis = <5000>; /* millicelsius */
                                type = "passive";
                        };
                        cpu_crit0: cpu-crit0 {
                                temperature = <195000>; /* millicelsius */
                                hysteresis = <5000>; /* millicelsius */
                                type = "critical";
                        };
                };

                cooling-maps {
                        map0 {
                                trip = <&cpu_alert0>;
                                cooling-device =
					<&cpu0 0 7>;
                        };
                        map1 {
                                trip = <&cpu_hot0>;
                                cooling-device =
					<&thermal_cpu_hotplug 0 3>;
                        };
                        map2 {
                                trip = <&cpu_crit0>;
                                cooling-device =
					<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
                        };
                };
        };
	};

	gpio-controller@f4329280 {
		id = <0>;
	};

	sgpio-controller@f3224280 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "cortina,ca77xx-gpio";
		reg = <0x0 0xf3224280 0x0 0x24>,
		      <0x0 0xf3100058 0x0 0x04>;
		id = <1>;
		iomux;

		/* Saturn GPIO bank 0 w/o interrupt */
		sgpio0: bank@0 {
			gpio-controller;
			reg = <0>;
			ngpios = <16>;
			#gpio-cells = <2>;
		};
	};

	pon@f4329000 {
		compatible = "cortina,ca77xx-pon";
		reg = <0x0 0xf4329000  0x0 0x400>;
		pon-gpio = <&gpio0 2 GPIO_ACTIVE_LOW>;
		dyinggasp-gpio = <&gpio0 1 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio0>;
		interrupts = <2 IRQ_TYPE_EDGE_RISING>;
	};

	gpio-reset {
		compatible = "linux,gpio-reset";

		pcie0_device_rst: pcie0_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <150>;
		};

		pcie1_device_rst: pcie1_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <10>;
		};

		pcie2_device_rst: pcie2_device {
			#reset-cells = <0>;
			/* 255 will inactive this node */
			gpios = <&gpio0 255 GPIO_ACTIVE_LOW>;
			asserted-state = <0>;
			/* device reset pulse width */
			duration-ms = <10>;
		};
	};
};

/* "okay" - turn on, "disabled" - turn off */
&glb_phy {
	forced-on;
};

&pcie0 {
	/* status = "disabled"; */

	resets = <&block_rst PCI0_RESET>, <&dphy_rst PHY_S0_PCIE_RESET>, <&pcie0_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <150>; /* device with embedded OS system */

	dma-coherent;
	linux,pci-domain = <0>;
	bus-range = <0x0 0x0>; /* save scan time */

	target_gen = <2>;
	target_lanes = <2>;

	serdes-cfg0 = <0xf4333004 0xa84a>,
		      <0xf4333008 0x6042>,
		      <0xf4333010 0x4000>,	/* BIT13: SSC */
		      <0xf4333018 0x001f>,
		      <0xf4333024 0x520c>,
		      <0xf4333028 0x9273>,
		      <0xf433302c 0x7905>,
		      <0xf4333034 0xf722>,
		      <0xf433303c 0x6000>,
		      <0xf4333044 0x4400>,
		      <0xf4333068 0x0000>,
		      <0xf4333070 0x0420>,
		      <0xf4333080 0x9477>,
		      <0xf4333090 0x080c>,
		      <0xf4333098 0xc40b>,
		      <0xf43330ac 0xa803>,

		      <0xf4333104 0xa84a>,
		      <0xf4333108 0x6042>,	/* BIT13: SSC */
		      <0xf4333110 0x4000>,
		      <0xf4333118 0x001f>,
		      <0xf4333124 0x520c>,
		      <0xf4333128 0x9273>,
		      <0xf433312c 0x7905>,
		      <0xf4333134 0xf722>,
		      <0xf433313c 0x6000>,
		      <0xf4333144 0x4400>,
		      <0xf4333168 0x0000>,
		      <0xf4333170 0x0420>,
		      <0xf4333180 0x9477>,
		      <0xf4333190 0x080c>,
		      <0xf4333198 0xc40b>,
		      <0xf43331ac 0xa803>;

	serdes-cfg1 = <0xf4334004 0xa84a>,
		      <0xf4334008 0x6042>,
		      <0xf4334010 0x4000>,	/* BIT13: SSC */
		      <0xf4334018 0x001f>,
		      <0xf4334024 0x520c>,
		      <0xf4334028 0x9273>,
		      <0xf433402c 0x7905>,
		      <0xf4334034 0xf722>,
		      <0xf433403c 0x6000>,
		      <0xf4334044 0x4400>,
		      <0xf4334068 0x0000>,
		      <0xf4334070 0x0420>,
		      <0xf4334080 0x9477>,
		      <0xf4334090 0x080c>,
		      <0xf4334098 0xc40b>,
		      <0xf43340ac 0xa803>,

		      <0xf4334104 0xa84a>,
		      <0xf4334108 0x6042>,
		      <0xf4334110 0x4000>,	/* BIT13: SSC */
		      <0xf4334118 0x001f>,
		      <0xf4334124 0x520c>,
		      <0xf4334128 0x9273>,
		      <0xf433412c 0x7905>,
		      <0xf4334134 0xf722>,
		      <0xf433413c 0x6000>,
		      <0xf4334144 0x4400>,
		      <0xf4334168 0x0000>,
		      <0xf4334170 0x0420>,
		      <0xf4334180 0x9477>,
		      <0xf4334190 0x080c>,
		      <0xf4334198 0xc40b>,
		      <0xf43341ac 0xa803>;
};

&pcie1 {
	/* status = "disabled"; */

	resets = <&block_rst PCI1_RESET>, <&dphy_rst PHY_S1_PCIE_RESET>, <&pcie1_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <50>;

	dma-coherent;
	linux,pci-domain = <1>;
	bus-range = <0x0 0x0>; /* save scan time */
};

&pcie2 {
	status = "disabled";

	resets = <&block_rst PCI2_RESET>, <&dphy_rst PHY_S2_PCIE_RESET>, <&pcie2_device_rst>;
	reset-names = "core_reset", "phy_reset", "device_reset";

	ready-time = /bits/ 16 <50>;

	/* forced-gen1; */
	dma-coherent;
	linux,pci-domain = <2>;
	bus-range = <0x0 0x0>; /* save scan time */
};

&usb_hsphy {
	status = "okay";
};

&usb_ssphy {
	status = "okay";
	portmask = <0x3>;
	phy-vbus-gpio = <&gpio0 4 GPIO_ACTIVE_HIGH>;
};

&sata {
	status = "disabled";
	/* dma-coherent; */
	phys = <&s3_sata_phy>;
	phy-names = "sata-phy";
};

&i2c {
	clock-frequency = <100000>;
	timeout = <1000>;
	retries = <3>;

	i2c-switch@70 {
		compatible = "nxp,pca9544";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x70>;
		status = "disabled";

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;

			hwmon@48 {
				compatible = "nxp,lm75a";
				reg = <0x48>;
				status = "disabled";
			};
		};
	};

	i2c-switch@71 {
		compatible = "nxp,pca9544";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x71>;
		/* status = "disabled"; */

		i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			ads1015@48 {
				compatible = "ti,ads1015";
				reg = <0x48>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};

			ads1015@49 {
				compatible = "ti,ads1015";
				reg = <0x49>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			ads1015@48 {
				compatible = "ti,ads1015";
				reg = <0x48>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};

			ads1015@49 {
				compatible = "ti,ads1015";
				reg = <0x49>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};
		};

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;

			ads1015@48 {
				compatible = "ti,ads1015";
				reg = <0x48>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};

			ads1015@49 {
				compatible = "ti,ads1015";
				reg = <0x49>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;

			ads1015@48 {
				compatible = "ti,ads1015";
				reg = <0x48>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};

			ads1015@49 {
				compatible = "ti,ads1015";
				reg = <0x49>;
				#address-cells = <1>;
				#size-cells = <0>;

				channel@0 {
					reg = <0>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
				channel@3 {
					reg = <3>;
					ti,gain = <1>;
					ti,datarate = <3>;
				};
			};
		};
	};
};

&spi0 {
	/* explained here proslic_api/docs/ProSLIC_API_QuickStart_Linux.pdf */
#if 1
	/* Si32183: channel_count = 1, with isi, mode spi-cpha
	 * Si32285: channel_count = 2, with isi, mode spi-cpha
	 */
	proslic_spi0: proslic_spi0@0 {
		compatible = "silabs,proslic_spi", "rohm,dh2228fv";
		status = "okay";
		spi-max-frequency = <2500000>;
		reg = <0>;
		isi;
		spi-cpha;
		channel_count = <2>;
		debug_level = <7>;
		reset-gpio = <&gpio0 15 GPIO_ACTIVE_LOW>;
	};
#endif

#if 0
	/* Si32287: channel_count = 1, w/o isi, mode spi-cpha/spi-cpol */
	proslic_spi0: proslic_spi0@0 {
		compatible = "silabs,proslic_spi", "rohm,dh2228fv";
		status = "okay";
		spi-max-frequency = <2500000>;
		reg = <0>;
		spi-cpha;
		spi-cpol;
		channel_count = <2>;
		debug_level = <7>;
		/* reset-gpio = <&gpio0 3 GPIO_ACTIVE_LOW>; */
	};
#endif

#if 0
	voicepath_spi0: voicepath_spi0@0 {
		compatible = "microsemi,voicepath_spi", "rohm,dh2228fv";
		status = "okay";
		spi-max-frequency = <2500000>;
		reg = <0>;
		zsi;
		spi-cpha;
		spi-cpol;
		channel_count = <2>;
		debug_level = <7>;
		/* reset-gpio = <&gpio0 3 GPIO_ACTIVE_LOW>; */
        };
#endif
};

&audio {
	clocks = <&slic_clk>;
};

&led_ctrl {
	hw-blink-rate1 = <256>;
	hw-blink-rate2 = <512>;
};

&led0 {
	active-low;
	label = "green:led0";
	blinking,hw-rx;
	port = <4>;
	blink-rate1;
	default-state = "disabled";
};

