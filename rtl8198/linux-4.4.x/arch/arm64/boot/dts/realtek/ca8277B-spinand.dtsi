/ {
	spi-nand@f4324000 {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "cortina,spi-nand";
		reg = <0x00000004 0xf4324000 0x0 0x40>;
		/* spinand,mfr-name = "micron"; */
		io-mode = <0xa00>;	/*  #define SPI_TX_QUAD 0x200
								#define SPI_RX_DUAL 0x400
								#define SPI_RX_QUAD 0x800
							*/
		/* Quard mode IO need to hook PINCTRL for pin-multiplexing */
		/* pinctrl-0 = <&sflash4_ctrl_default>; */
		/* pinctrl-names = "default"; */

		ATF@0 {
			label = "bootloader";
			reg = <0x0 0x0 0x0 0x400000>;
		};

		uboot-env@400000 {
			label = "uboot-env";
			reg = <0x0 0x400000 0x0 0x100000>;
		};

		dtb@500000 {
			label = "device-tree";
			reg = <0x0 0x500000 0x0 0x100000>;
		};

		kernel@600000 {
			label = "kernel";
			reg = <0x0 0x600000 0x0 0x600000>;
		};

		rootfs@C00000 {
			label = "rootfs";
			reg = <0x0 0xC00000 0x0 0x5000000>;
		};

		userdata@5C00000{
			label = "userdata";
			reg = <0x0 0x5C00000 0x0 0x1400000>;
		};
	};
};
