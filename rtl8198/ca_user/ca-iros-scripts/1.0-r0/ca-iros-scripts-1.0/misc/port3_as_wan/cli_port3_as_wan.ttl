;;please enter app-cli config/aal tree before sending the following commands

;;enable da mac check for L3_WAN(0x18)
sendln 'l3_stg0'
sendln 'lpb_tbl 0 mac_da_an_mask 2 4'
sendln 'exit'

;;set spcl rule for ARP from port 3 to cpu port(0x10)
sendln 'l2_specpkt'
sendln 'ctrl 0 ldpid 1 0xe 0x10'
sendln 'ctrl 0 spcl_fwd 1 0xe 1'
;;set spcl rule for NDP from port 3 to cpu port(0x10)
sendln 'ctrl 0 ldpid 1 0x13 0x10'
sendln 'ctrl 0 spcl_fwd 1 0x13 1'
;;set spcl rule for PPP Discovery from port 3 to cpu port(0x10)
sendln 'ctrl 0 ldpid 1 0x11 0x10'
sendln 'ctrl 0 spcl_fwd 1 0x11 1'

