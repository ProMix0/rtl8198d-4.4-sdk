;; DS-Lite Multicast
;;
;; WAN2LAN, from port 0x7 to port 0x1
;;   mac_sa = 00-c0-a8-ab-cd-ef
;;   mac_da = 33-33-ef-00-00-01
;;   outer v6_src = 3001::c000:0001 (aftr)
;;   outer v6_dest = ff38::ef00:0001 (b4)
;;   inner v4_src = 192.0.0.1
;;   inner v4_dest = 239.0.0.1
;;   sport = 63
;;   dport = 63
;;   NO vid

;; clear keep_orig_pkt in L3FE_STG1_DSL_IPMC_FWD_CTRL
sendln 'devmem 0xf4303410 32 0x00c8ffff'
wait 'root@OpenWrt:'

sendln 'iros'
wait 'ca-iros->'

;; T3, LPM (only set t4ctrl)

sendln 'cd /etc/cortina/iros/aal/lpm'
wait 'ca-iros->'

sendln 'source set_default_t4ctrl.tcl'
wait 'ca-iros->'

sendln 'source add_lpm_v4_wan2lan.tcl'
wait 'ca-iros->'

;; DS-Lite Table
;;   It sets LPM, NextHop, Hash(if NAT is needed).

sendln 'cd /etc/cortina/iros/aal/dslite'
wait 'ca-iros->'

sendln 'source add_1.tcl'
wait 'ca-iros->'

sendln 'cd /etc/cortina/iros/aal/hashlite'
wait 'ca-iros->'

sendln 'source add_hash_v4_wan2lan.tcl'
wait 'ca-iros->'

sendln 'cd /'
wait 'ca-iros->'
sendln 'exit'
wait 'root@OpenWrt:'

;; IF Table

sendln 'app-cli'
wait 'Cortina>'
sendln 'enable'
wait 'Cortina#'
sendln 'config'
wait 'Cortina(config)#'
sendln 'aal'
wait 'Cortina(config-aal)#'
sendln 'l3_if'
wait 'Cortina(config-aal-l3_if)#'

;; IF Table, entry 49 for port 0x7 (WAN)

sendln 'l3_if ldpid_vld 49 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if ldpid 49 0x7'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if mac_sa_vld 49 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if mac_sa_an_sel 49 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if vlan_vld 49 0'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if vlan_cnt 49 0'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if deep_q 49 1'
wait 'Cortina(config-aal-l3_if)#'

;; IF Table, entry 1 for port 0x19 (LAN)

sendln 'l3_if ldpid_vld 1 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if ldpid 1 0x19'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if mac_sa_vld 1 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if mac_sa_an_sel 1 1'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if vlan_vld 1 0'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if vlan_cnt 1 0'
wait 'Cortina(config-aal-l3_if)#'
sendln 'l3_if deep_q 1 1'
wait 'Cortina(config-aal-l3_if)#'


sendln 'exit'
wait 'Cortina(config-aal)#'

;; Classifier
sendln 'l3_cls'
wait 'Cortina(config-aal-l3_cls)#'

;; Classifier for MC downstream
sendln 'key_clean 0 6'

;;set the key of lspid
sendln 'full_key lspid 0 0x7'
sendln 'full_key msk_lspid 0 0'

;; mac_da_ip_mc
sendln 'full_key mac_da_ip_mc 0 1'
sendln 'full_key msk_mac_da_ip_mc 0 0'

;; ip_vld
sendln 'full_key ip_vld 0 1'
sendln 'full_key msk_ip_vld 0 0'

;; ip_da_mc
sendln 'full_key ip_da_mc 0 1'
sendln 'full_key msk_ip_da_mc 0 0'

;;set the key of ip_sa to 3001::c000:0001, msk 128
;;sendln 'full_key ip_sa_3 0 0x30010000'
;;sendln 'full_key ip_sa_2 0 0'
;;sendln 'full_key ip_sa_1 0 0'
;;sendln 'full_key ip_sa_0 0 0xc0000001'
;;sendln 'full_key msk_ip_sa_h 0 1'
;;sendln 'full_key msk_ip_sa_l 0 0'

;;set the key of ip_da to ff38::ef00:0001, msk 128
sendln 'full_key ip_da_3 0 0xff380000'
sendln 'full_key ip_da_2 0 0'
sendln 'full_key ip_da_1 0 0'
sendln 'full_key ip_da_0 0 0xef000001'
sendln 'full_key msk_ip_da_h 0 0'
sendln 'full_key msk_ip_da_l 0 16'

sendln 'full_key ip_protocol 0 0x4'
sendln 'full_key msk_ip_protocol 0 0'

;;enable the key
sendln 'full_key cls_key_valid 0 1'
sendln 'full_key cls_pri 0 15'
sendln 'full_key cls_rslt_type 0 1'

;;clean fib 0 fields in fib table index 4
sendln 'fib_clean 4 0'

;;set the fib of mcgid to 0x19
sendln 'fib_0 dpid_vld 4 1'
sendln 'fib_0 permit 4 1'
sendln 'fib_0 mcgid 4 0x19'

;; set ingress if_id to 0x31 (dslite entry 1)
sendln 'fib_0 mdata_w_1 4 0x3100'
sendln 'fib_0 mdata_w_vld_1 4 0xc'

;; pop outer L3 hdr (ipv6 hdr)
sendln 'fib_0 pop_l3_en 4 1'
sendln 'fib_0 pop_l3_vld 4 1'

;; set t2ctrl to 0xf
sendln 'fib_0 t2_ctrl 4 0xf'
sendln 'fib_0 t2_ctrl_vld 4 1'
sendln 'fib_0 t3_ctrl 4 0x0'
sendln 'fib_0 t3_ctrl_vld 4 1'
sendln 'fib_0 t4_ctrl 4 0x0'
sendln 'fib_0 t4_ctrl_vld 4 1'

;;show key and fib settings
;;sendln 'show aal l3_cls full_key 0'
;;sendln 'show aal l3_cls fib_0 4'

sendln 'logout'

