OBJS_CFLAGS :=
OBJS_CFLAGS += -I$(DIR_VOIP)/voip_drivers/intel/drv_dxs-1.3.0.11/
OBJS_CFLAGS += -I$(DIR_VOIP)/voip_drivers/intel/drv_dxs-1.3.0.11/src/
