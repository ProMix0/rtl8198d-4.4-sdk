OBJS_CFLAGS += -I$(DIR_VOIP)/voip_drivers/intel/drv_tapi-4.17.0.7/include/
OBJS_CFLAGS += -I$(DIR_VOIP)/voip_drivers/intel/lib_ifxos-1.6.9/src/include/
