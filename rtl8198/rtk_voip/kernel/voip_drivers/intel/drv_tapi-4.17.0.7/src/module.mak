OBJS_CFLAGS += -I$(DIR_VOIP)/voip_drivers/
OBJS_CFLAGS += -I$(DIR_VOIP)/include/
OBJS_CFLAGS += -I$(LINUXDIR)/include
OBJS_CFLAGS += -DLINUX -DTAPI_HAVE_TIMERS -DHAVE_CONFIG_H -D__KERNEL__ -DRW_MULTI_THREAD -D_REENTRANT -D_THREAD_SAFE -D_POSIX_SOURCE -D_GNU_SOURCE -Wall -Wimplicit -Wreturn-type -Wunused -Wswitch -Wcomment -Wparentheses
OBJS_CFLAGS += -DREALTEK_PATCH_FOR_INTEL

#include $(DIR_VOIP)/rules.mak

