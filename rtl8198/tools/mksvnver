#!/bin/sh

SVN_VER_H="$ROOTDIR/tools/svn_version.h"
SDK_VER_H="$ROOTDIR/$LINUXDIR/luna_sdk_ver"
DIR_NIC_DRIVER_SOURCE="$ROOTDIR/$LINUXDIR/drivers/net/ethernet/realtek/rtl86900/"
DIR_NIC_DRIVER_HEADER="$ROOTDIR/$LINUXDIR/include/net/"
DIR_WLAN_DIRVER_SOURCE="$ROOTDIR/$LINUXDIR/drivers/net/wireless/rtl8192cd/"
DIR_WLAN_DIRVER_HEADER="$ROOTDIR/$LINUXDIR/drivers/net/wireless/rtl8192cd/"
DELIMITER="-r"


# Get current SDK version
SDK_VER1=`cat $SDK_VER_H | tr -s "[\t]" " " | cut -d " " -f2`
SDK_VER2=`cat $SDK_VER_H | tr -s "[\t]" " " | cut -d " " -f3`
SDK_VER3=`cat $SDK_VER_H | tr -s "[\t]" " " | cut -d " " -f4`
N="-"
#SDK_VER=`cat $SDK_VER_H | tr -s "[\t]" " " | cut  -f1`

# Get SVN subversion
SVN_VER=`svn info | grep Revision | cut -f2 -d" "`

# Append sub version to SDK version 
CURRENT_VER="$SDK_VER1$N$SDK_VER2$N$SDK_VER3$DELIMITER$SVN_VER"

# Check current version
touch $SVN_VER_H
if [ -f $SVN_VER_H ]; then 
	echo "The SDK version is:\"$CURRENT_VER\"" > $SVN_VER_H
	NIC_DRIVER_C_VER=`svn info $DIR_NIC_DRIVER_SOURCE | grep Rev:| cut -f4 -d " " | sed -n 1p`
	NIC_DRIVER_H_VER=`svn info $DIR_NIC_DRIVER_HEADER | grep Rev: | cut -f4 -d " " | sed -n 1p`
	echo "Ethernet driver version is:\"$NIC_DRIVER_C_VER-$NIC_DRIVER_H_VER\"" >> $SVN_VER_H
	WLAN_DRIVER_C_VER=`svn info $DIR_WLAN_DRIVER_SOURCE | grep Rev: | cut -f4 -d " " | sed -n 1p`
	WLAN_DRIVER_H_VER=`svn info $DIR_WLAN_DRIVER_HEADER | grep Rev: | cut -f4 -d " " | sed -n 1p`
	echo "Wireless driver version is:\"$WLAN_DRIVER_C_VER-$WLAN_DRIVER_H_VER\"" >> $SVN_VER_H
fi


