#
# Basic var for special product
#

# SDK Path
SDK_DIR:=$(shell cd $(BUILD_DIR)/../../rtl8198 && pwd)
SDK_ROOT_DIR:=$(SDK_DIR)
SDK_ROOTFS_DIR:=$(SDK_DIR)/romfs
SDK_BOOT_DIR:=$(SDK_DIR)/bootloader
SDK_BOOT_IMG_DIR:=$(SDK_BOOT_DIR)/bismarck_V3.7/release
SDK_BOOT_ENV_TOOL:=$(SDK_BOOT_DIR)/bismarck_V3.7//uboot_v2020.01/tools/env/fw_printenv
SDK_KERNEL_DIR:=$(SDK_ROOT_DIR)/linux-4.4.x
SDK_HOST_TOOL_DIR:=$(SDK_DIR)/tools

# IMAGE
IMAGE_ROOTFS_DIR:=$(IMAGE_DIR)/rootfs

# TOOL
HOSTTOOLS_DIR:=$(BUILD_DIR)/hostTools/make_flash_nand/bin
HOSTTOOLS_SRC_DIR:=$(BUILD_DIR)/hostTools/make_flash_nand/src

 # iplatform
LUAC?=$(PLATFORM_DIR)/staging_dir/host/bin/luac
LUA_PATH?=$(IMAGE_ROOTFS_DIR)/usr/lib/lua
